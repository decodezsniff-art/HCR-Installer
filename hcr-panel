#!/usr/bin/env bash
# ADMINISTRADOR HCRCUSTOM - panel de administración HCR Server
set -Eeuo pipefail

REPO="https://raw.githubusercontent.com/decodezsniff-art/HCR-Installer/main"
DIR="/opt/hcr-server"
BIN="$DIR/hcr-server"
SERVICE="/etc/systemd/system/hcr-server.service"
BBR_CONF="/etc/sysctl.d/99-hcrcustom-bbr.conf"
BBR_STATE="/etc/hcr-server/hcrcustom-bbr.state"

G='\033[0;32m'; R='\033[0;31m'; Y='\033[1;33m'; B='\033[0;34m'
C='\033[0;36m'; M='\033[0;35m'; N='\033[0m'

ok(){ echo -e "${G}[OK]${N} $*"; }
info(){ echo -e "${B}[INFO]${N} $*"; }
warn(){ echo -e "${Y}[AVISO]${N} $*"; }
err(){ echo -e "${R}[ERROR]${N} $*" >&2; }
pause(){ echo; read -r -p "Presiona ENTER para continuar..." _ || true; }

root_check(){
    if (( EUID != 0 )); then err "Ejecuta como root."; exit 1; fi
}
installed(){ [[ -x "$BIN" ]] && systemctl cat hcr-server.service >/dev/null 2>&1; }

confirm(){
    local answer
    read -r -p "$1 [s/N]: " answer || return 1
    [[ "$answer" =~ ^([sS]|[sS][iI])$ ]]
}

download_run(){
    local file="$1" tmp rc
    tmp="$(mktemp)"
    if ! curl -fsSL --retry 3 "$REPO/$file" -o "$tmp"; then
        rm -f "$tmp"; err "No se pudo descargar $file"; return 1
    fi
    if ! bash -n "$tmp"; then rm -f "$tmp"; err "$file contiene errores de sintaxis."; return 1; fi
    if bash "$tmp"; then rc=0; else rc=$?; fi
    rm -f "$tmp"
    return "$rc"
}

# Lee ExecStart como tokens simples. El servicio HCR generado por este panel usa
# argumentos sin espacios; los valores externos desconocidos se conservan.
load_exec(){
    local line
    [[ -r "$SERVICE" ]] || { err "No se puede leer $SERVICE"; return 1; }
    line="$(sed -n 's/^ExecStart=//p' "$SERVICE" | tail -n 1)"
    [[ -n "$line" ]] || { err "No se encontró ExecStart en $SERVICE"; return 1; }
    read -r -a EXEC_ARGS <<< "$line"
    [[ "${EXEC_ARGS[0]:-}" == "$BIN" ]] || {
        err "ExecStart no apunta al binario esperado ($BIN). No se modificó nada."; return 1;
    }
}

arg_value(){
    local wanted="$1" i
    for ((i=1; i<${#EXEC_ARGS[@]}; i++)); do
        if [[ "${EXEC_ARGS[i]}" == "$wanted" ]]; then
            printf '%s' "${EXEC_ARGS[i+1]:-}"
            return 0
        fi
    done
    return 0
}

read_config(){
    load_exec || return 1
    PORT="$(arg_value -listen)"; PORT="${PORT#:}"; PORT="${PORT:-8880}"
    TARGET="$(arg_value -target)"; TARGET="${TARGET:-127.0.0.1:22}"
    TRANSPORT="$(arg_value -transport)"; TRANSPORT="${TRANSPORT:-plain}"
    CERT="$(arg_value -tls-cert)"; KEY="$(arg_value -tls-key)"
    FRAME="$(arg_value -max-download-frame)"; FRAME="${FRAME:-16384}"
    POLL="$(arg_value -download-poll-timeout)"; POLL="${POLL:-0}"
    DIAG="$(arg_value -diagnostics-interval)"; DIAG="${DIAG:-0}"
    STATS="$(arg_value -session-stats-interval)"; STATS="${STATS:-0}"
}

# Cambia/aggiunge un flag e conserva tutti gli altri argomenti, anche quelli
# non conosciuti da HCRCUSTOM. Un flag ripetuto viene normalizzato a una sola voce.
set_exec_arg(){
    local flag="$1" value="$2" i found=0
    local -a out=("${EXEC_ARGS[0]}")
    for ((i=1; i<${#EXEC_ARGS[@]}; i++)); do
        if [[ "${EXEC_ARGS[i]}" == "$flag" ]]; then
            if (( found == 0 )); then out+=("$flag" "$value"); found=1; fi
            i=$((i + 1))
        else
            out+=("${EXEC_ARGS[i]}")
        fi
    done
    (( found )) || out+=("$flag" "$value")
    EXEC_ARGS=("${out[@]}")
}

remove_exec_arg(){
    local flag="$1" i
    local -a out=("${EXEC_ARGS[0]}")
    for ((i=1; i<${#EXEC_ARGS[@]}; i++)); do
        if [[ "${EXEC_ARGS[i]}" == "$flag" ]]; then i=$((i + 1)); else out+=("${EXEC_ARGS[i]}"); fi
    done
    EXEC_ARGS=("${out[@]}")
}

write_exec(){
    local tmp line token
    tmp="$(mktemp "${SERVICE}.XXXXXX")"
    line=""
    for token in "${EXEC_ARGS[@]}"; do
        [[ "$token" =~ ^[a-zA-Z0-9_./:@+-]+$ ]] || {
            rm -f "$tmp"; err "Argumento con caracteres no admitidos: $token"; return 1;
        }
        line+=" $token"
    done
    line="ExecStart=${line# }"
    awk -v replacement="$line" '
        /^ExecStart=/ { if (!done) { print replacement; done=1 }; next }
        { print }
        END { if (!done) exit 3 }
    ' "$SERVICE" > "$tmp" || { rm -f "$tmp"; err "No se pudo generar el servicio."; return 1; }
    chmod --reference="$SERVICE" "$tmp"
    cp -a "$SERVICE" "${SERVICE}.hcrcustom.bak.$(date +%Y%m%d%H%M%S)"
    if ! cat "$tmp" > "$SERVICE"; then rm -f "$tmp"; err "No se pudo escribir el servicio."; return 1; fi
    rm -f "$tmp"
    if ! systemctl daemon-reload || ! systemctl restart hcr-server.service; then
        err "No se pudo aplicar el cambio. Restaurando respaldo."
        local backup
        backup="$(ls -1t "${SERVICE}.hcrcustom.bak."* 2>/dev/null | head -n1 || true)"
        if [[ -n "$backup" ]]; then cp -a "$backup" "$SERVICE"; systemctl daemon-reload || true; systemctl restart hcr-server.service || true; fi
        return 1
    fi
    sleep 2
    if ! systemctl is-active --quiet hcr-server.service; then
        err "HCR no quedó activo. Restaurando respaldo."
        local backup
        backup="$(ls -1t "${SERVICE}.hcrcustom.bak."* 2>/dev/null | head -n1 || true)"
        if [[ -n "$backup" ]]; then cp -a "$backup" "$SERVICE"; systemctl daemon-reload || true; systemctl restart hcr-server.service || true; fi
        return 1
    fi
    ok "Configuración aplicada y servicio activo."
}

validate_port(){ [[ "$1" =~ ^[0-9]{1,5}$ ]] && (( 10#$1 >= 1 && 10#$1 <= 65535 )); }
valid_duration(){ [[ "$1" == 0 || "$1" =~ ^[1-9][0-9]*(ms|s|m|h)$ ]]; }

change_port(){
    read_config || return 1
    echo "Puerto HCR actual: $PORT"
    local value
    read -r -p "Nuevo puerto HCR: " value
    validate_port "$value" || { err "Puerto inválido (1-65535)."; return 1; }
    if [[ "$value" != "$PORT" ]] && ss -H -ltn | awk -v p=":$value" '$4 ~ (p "$"){f=1} END{exit !f}'; then
        err "El puerto $value ya está ocupado."; return 1
    fi
    set_exec_arg -listen ":$value"; write_exec
}

change_redirect_port(){
    read_config || return 1
    local host port value
    if [[ "$TARGET" == *:* ]]; then host="${TARGET%:*}"; port="${TARGET##*:}"; else host="$TARGET"; port=22; fi
    echo "Destino actual: $TARGET (host conservado: $host)"
    read -r -p "Nuevo puerto de redirección SSH [$port]: " value
    [[ -n "$value" ]] || return 0
    validate_port "$value" || { err "Puerto inválido."; return 1; }
    [[ "$host" =~ ^[a-zA-Z0-9_.-]+$ ]] || { err "Host actual no válido; no se modificó."; return 1; }
    set_exec_arg -target "$host:$value"; write_exec
}

configure_frame_only(){
    read_config || return 1
    local value
    echo "Max Download Frame actual: $FRAME"
    read -r -p "Nuevo Max Download Frame (1-262140): " value
    [[ "$value" =~ ^[0-9]{1,6}$ ]] && (( 10#$value >= 1 && 10#$value <= 262140 )) || { err "Valor inválido."; return 1; }
    set_exec_arg -max-download-frame "$value"; write_exec
}

configure_poll_only(){
    read_config || return 1
    local value
    echo "Download Poll Timeout actual: $POLL"
    read -r -p "Nuevo timeout (0, 500ms, 5s, 1m...): " value
    valid_duration "$value" || { err "Duración inválida."; return 1; }
    set_exec_arg -download-poll-timeout "$value"; write_exec
}

configure_transport(){
    read_config || return 1
    local choice cert key
    echo "Transporte actual: $TRANSPORT"
    echo "1) SSL/TLS ON (tls)"; echo "2) SSL/TLS OFF (plain)"; echo "3) Auto"
    read -r -p "Selecciona: " choice
    case "$choice" in
        1|3)
            read -r -p "Ruta del certificado [$CERT]: " cert; cert="${cert:-$CERT}"
            read -r -p "Ruta de la clave privada [$KEY]: " key; key="${key:-$KEY}"
            [[ "$cert" =~ ^[a-zA-Z0-9_./-]+$ && "$key" =~ ^[a-zA-Z0-9_./-]+$ ]] || { err "Ruta no válida."; return 1; }
            [[ -f "$cert" && -r "$cert" && -f "$key" && -r "$key" ]] || { err "No existen o no se pueden leer ambos archivos TLS."; return 1; }
            if command -v openssl >/dev/null 2>&1; then
                openssl x509 -in "$cert" -noout >/dev/null 2>&1 || { err "Certificado X.509 inválido."; return 1; }
                openssl pkey -in "$key" -noout >/dev/null 2>&1 || { err "Clave privada inválida."; return 1; }
            fi
            [[ "$choice" == 1 ]] && set_exec_arg -transport tls || set_exec_arg -transport auto
            set_exec_arg -tls-cert "$cert"; set_exec_arg -tls-key "$key"
            ;;
        2)
            set_exec_arg -transport plain; remove_exec_arg -tls-cert; remove_exec_arg -tls-key
            ;;
        *) err "Opción inválida."; return 1 ;;
    esac
    write_exec
}

configure_limits(){
    read_config || return 1
    local conn sess per value
    conn="$(arg_value -max-connections)"; conn="${conn:-2048}"
    sess="$(arg_value -max-sessions)"; sess="${sess:-32}"
    per="$(arg_value -max-sessions-per-ip)"; per="${per:-0}"
    echo "Conexiones=$conn | Sesiones=$sess | Sesiones/IP=$per (0=automático)"
    read -r -p "Máximo de conexiones [$conn]: " value; conn="${value:-$conn}"
    read -r -p "Máximo de sesiones [$sess]: " value; sess="${value:-$sess}"
    read -r -p "Máximo de sesiones por IP [$per]: " value; per="${value:-$per}"
    [[ "$conn" =~ ^[0-9]+$ && "$sess" =~ ^[0-9]+$ && "$per" =~ ^[0-9]+$ ]] || { err "Usa números enteros."; return 1; }
    (( 10#$conn >= 1 && 10#$conn <= 2147483647 && 10#$sess >= 1 && 10#$sess <= 2147483647 && 10#$per <= 2147483647 && 10#$per <= 10#$sess )) || { err "Límites fuera de rango."; return 1; }
    set_exec_arg -max-connections "$conn"; set_exec_arg -max-sessions "$sess"; set_exec_arg -max-sessions-per-ip "$per"
    write_exec
}

configure_diagnostics(){
    read_config || return 1
    local value
    echo "Diagnostics Interval actual: $DIAG"
    read -r -p "Nuevo intervalo (0 o 10s-300s): " value
    if [[ "$value" != 0 ]]; then
        [[ "$value" =~ ^([0-9]+)s$ ]] && (( 10#${BASH_REMATCH[1]} >= 10 && 10#${BASH_REMATCH[1]} <= 300 )) || { err "Debe ser 0 o de 10s a 300s."; return 1; }
    fi
    set_exec_arg -diagnostics-interval "$value"; write_exec
}

configure_stats(){
    read_config || return 1
    local value
    echo "Session Stats Interval actual: $STATS"
    read -r -p "Nuevo intervalo (0 para desactivar, ej. 30s): " value
    valid_duration "$value" || { err "Duración inválida."; return 1; }
    set_exec_arg -session-stats-interval "$value"; write_exec
}

status_hcr(){ systemctl status hcr-server.service --no-pager -l || true; }
logs_hcr(){ journalctl -u hcr-server.service -n 100 --no-pager || true; }

show_active_ports(){
    local file port transport service count=0
    if systemctl is-active --quiet hcr-server.service; then
        read_config || true
        printf "  ${G}●${N} Principal: puerto %-5s | destino %-18s | transporte %s\n" "${PORT:-?}" "${TARGET:-?}" "${TRANSPORT:-?}"
        ((count+=1))
    else echo -e "  ${R}● HCR principal detenido${N}"; fi
    shopt -s nullglob
    for file in /etc/hcr-server/ports/*.conf; do
        port="${file##*/}"; port="${port%.conf}"; service="hcr-server-port-${port}.service"
        transport="$(sed -n 's/^TRANSPORT=//p' "$file" | head -n1)"; transport="${transport:-desconocido}"
        if systemctl is-active --quiet "$service"; then printf "  ${G}●${N} Multiport %-5s | %s | ACTIVO\n" "$port" "$transport"; ((count+=1)); else printf "  ${R}●${N} Multiport %-5s | %s | DETENIDO\n" "$port" "$transport"; fi
    done
    shopt -u nullglob
    (( count > 0 )) || info "No hay puertos activos."
}

bbr_status(){
    echo "===== ESTADO BBR + FQ ====="
    printf 'TCP congestion control: '; sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || echo desconocido
    printf 'Qdisc predeterminado: '; sysctl -n net.core.default_qdisc 2>/dev/null || echo desconocido
    if [[ -f "$BBR_CONF" ]] && grep -q '^# HCRCUSTOM BBR FQ$' "$BBR_CONF"; then info "Persistencia HCRCUSTOM: ON"; else info "Persistencia HCRCUSTOM: no instalada"; fi
    if [[ -f "$BBR_STATE" ]]; then info "Respaldo de valores previos disponible."; else info "Sin respaldo HCRCUSTOM."; fi
}

bbr_enable(){
    local old_cc old_qdisc tmp
    if [[ -e "$BBR_STATE" ]]; then err "Ya existe un estado BBR guardado. Consulta el estado antes de cambiarlo."; return 1; fi
    if [[ -e "$BBR_CONF" ]]; then err "$BBR_CONF ya existe y no parece gestionado por este panel. No se sobrescribirá."; return 1; fi
    modprobe tcp_bbr 2>/dev/null || true; modprobe sch_fq 2>/dev/null || true
    grep -qw bbr /proc/sys/net/ipv4/tcp_available_congestion_control || { err "El kernel no ofrece BBR."; return 1; }
    old_cc="$(sysctl -n net.ipv4.tcp_congestion_control)" || return 1
    old_qdisc="$(sysctl -n net.core.default_qdisc)" || return 1
    install -d -m 700 /etc/hcr-server
    tmp="$(mktemp)"
    printf 'CC=%s\nQDISC=%s\n' "$old_cc" "$old_qdisc" > "$tmp"
    chmod 600 "$tmp"; mv "$tmp" "$BBR_STATE"
    if ! sysctl -w net.ipv4.tcp_congestion_control=bbr >/dev/null || ! sysctl -w net.core.default_qdisc=fq >/dev/null; then
        sysctl -w "net.ipv4.tcp_congestion_control=$old_cc" >/dev/null 2>&1 || true
        sysctl -w "net.core.default_qdisc=$old_qdisc" >/dev/null 2>&1 || true
        rm -f "$BBR_STATE"; err "No se pudieron aplicar ambos parámetros; se intentó restaurar los valores previos."; return 1
    fi
    tmp="$(mktemp)"
    printf '# HCRCUSTOM BBR FQ\nnet.ipv4.tcp_congestion_control=bbr\nnet.core.default_qdisc=fq\n' > "$tmp"
    chmod 644 "$tmp"; mv "$tmp" "$BBR_CONF"
    ok "BBR + FQ activados. No se reemplazaron qdiscs de interfaces activas ni se reinició HCR."
}

bbr_disable(){
    local old_cc old_qdisc
    [[ -f "$BBR_STATE" ]] || { info "No hay un estado previo guardado por HCRCUSTOM; no se cambiará la configuración del sistema."; return 0; }
    grep -q '^# HCRCUSTOM BBR FQ$' "$BBR_CONF" 2>/dev/null || { err "No se reconoce el archivo de persistencia; no se eliminará."; return 1; }
    old_cc="$(sed -n 's/^CC=//p' "$BBR_STATE")"; old_qdisc="$(sed -n 's/^QDISC=//p' "$BBR_STATE")"
    [[ "$old_cc" =~ ^[a-zA-Z0-9_-]+$ && "$old_qdisc" =~ ^[a-zA-Z0-9_-]+$ ]] || { err "El respaldo no es válido; se conserva para revisión."; return 1; }
    sysctl -w "net.ipv4.tcp_congestion_control=$old_cc" >/dev/null || { err "No se pudo restaurar congestion_control; se conserva el respaldo."; return 1; }
    sysctl -w "net.core.default_qdisc=$old_qdisc" >/dev/null || { err "No se pudo restaurar default_qdisc; se conserva el respaldo."; return 1; }
    rm -f "$BBR_CONF"; rm -f "$BBR_STATE"
    ok "Se restauraron los valores previos guardados. No se reinició HCR."
}

bbr_menu(){
    local option
    while true; do
        clear; echo -e "${C}===== HIGH PERFORMANCE (BBR + FQ) =====${N}"
        bbr_status; echo; echo "[1] Activar BBR + FQ"; echo "[2] Desactivar BBR + FQ"; echo "[3] Consultar estado"; echo "[0] Volver"
        read -r -p "Selecciona: " option
        case "$option" in
            1) confirm "¿Activar BBR + FQ?" && bbr_enable; pause ;;
            2) confirm "¿Desactivar BBR + FQ y restaurar valores previos?" && bbr_disable; pause ;;
            3) bbr_status; pause ;;
            0) return ;;
            *) warn "Opción inválida."; sleep 1 ;;
        esac
    done
}

more_options_menu(){
    local option
    while true; do
        clear; echo -e "${C}===== MÁS OPCIONES =====${N}"
        echo "[1] Límites de conexiones y sesiones"
        echo "[2] Diagnostics Interval"
        echo "[3] Session Stats Interval"
        echo "[4] Ver registros"
        echo "[5] Administrar múltiples puertos"
        echo "[6] Actualizar HCR (binario y archivos del proyecto)"
        echo "[7] Instalar HCR"
        echo "[0] Volver"
        read -r -p "Selecciona: " option
        case "$option" in
            1) installed && configure_limits || err "No se pudo configurar límites."; pause ;;
            2) installed && configure_diagnostics || err "No se pudo configurar diagnostics."; pause ;;
            3) installed && configure_stats || err "No se pudo configurar estadísticas."; pause ;;
            4) logs_hcr; pause ;;
            5) if [[ -x /usr/local/bin/hcr-ports ]]; then /usr/local/bin/hcr-ports; else err "No se encontró /usr/local/bin/hcr-ports."; fi; pause ;;
            6) if confirm "La actualización puede reemplazar el binario HCR. ¿Continuar?"; then download_run update.sh || err "La actualización falló."; fi; pause ;;
            7) if confirm "¿Ejecutar el instalador del repositorio?"; then download_run install.sh || err "La instalación falló."; fi; pause ;;
            0) return ;;
            *) warn "Opción inválida."; sleep 1 ;;
        esac
    done
}

service_toggle(){
    if systemctl is-active --quiet hcr-server.service; then
        if confirm "HCR está activo. ¿Detenerlo?"; then systemctl stop hcr-server.service && ok "Servicio detenido."; fi
    else
        if confirm "HCR está detenido. ¿Iniciarlo?"; then systemctl start hcr-server.service && ok "Servicio iniciado."; fi
    fi
}

uninstall_hcr(){
    warn "La desinstalación puede eliminar el servicio y archivos de HCR."
    if confirm "¿CONFIRMAS desinstalar HCR?"; then download_run uninstall.sh || err "La desinstalación no terminó correctamente."; fi
}

install_hcr(){
    local tmp rc
    tmp="$(mktemp -d)"
    if ! curl -fsSL --retry 3 "$REPO/install.sh" -o "$tmp/install.sh" || ! curl -fsSL --retry 3 "$REPO/hcr-server" -o "$tmp/hcr-server"; then
        rm -rf "$tmp"; err "No se pudo descargar el instalador o el binario."; return 1
    fi
    chmod 0755 "$tmp/install.sh" "$tmp/hcr-server"
    bash -n "$tmp/install.sh" || { rm -rf "$tmp"; err "Instalador inválido."; return 1; }
    (cd "$tmp" && bash ./install.sh); rc=$?
    rm -rf "$tmp"
    return "$rc"
}

main_menu(){
    local option state tls
    while true; do
        clear
        echo -e "${C}╔══════════════════════════════════════════════╗"
        echo "║             ADMINISTRADOR HCRCUSTOM          ║"
        echo -e "╚══════════════════════════════════════════════╝${N}"
        if installed; then
            read_config || true
            state="$(systemctl is-active hcr-server.service 2>/dev/null || true)"
            [[ "$state" == active ]] && state="ACTIVO" || state="DETENIDO"
            [[ "${TRANSPORT:-plain}" == plain ]] && tls="OFF" || tls="ON"
            echo -e "Estado: ${G}$state${N}"
            printf '[1]> PUERTO HCR: %s\n' "${PORT:-?}"
            printf '[2]> PUERTO DE REDIRECCION: %s\n' "${TARGET##*:}"
            printf '[3]> MAX DOWNLOAD FRAME: %s\n' "${FRAME:-?}"
            printf '[4]> DOWNLOAD POLL TIMEOUT: %s\n' "${POLL:-?}"
            printf '[5]> MODO SSL/TLS [%s]\n' "$tls"
        else
            echo -e "Estado: ${R}NO INSTALADO${N}"
            echo "[1]> Instalar HCR Server"
        fi
        echo "[6]> HIGH PERFORMANCE (BBR + FQ) [consultar estado]"
        echo "[7]> ESTADO DEL SERVICIO"
        echo "[8]> REINICIAR SERVICIO"
        echo "[9]> INICIAR/PARAR SERVICIO"
        echo "[10]> DESINSTALAR"
        echo "[11]> MÁS OPCIONES"
        echo "[0] VOLVER"
        echo
        read -r -p "Selecciona una opción: " option
        case "$option" in
            1) if installed; then change_port; else if confirm "¿Instalar HCR desde el repositorio?"; then install_hcr; fi; fi; pause ;;
            2) installed && change_redirect_port || err "HCR no está instalado o no se pudo cambiar el destino."; pause ;;
            3) installed && configure_frame_only || err "No se pudo configurar FRAME."; pause ;;
            4) installed && configure_poll_only || err "No se pudo configurar Poll Timeout."; pause ;;
            5) installed && configure_transport || err "No se pudo configurar TLS."; pause ;;
            6) bbr_menu ;;
            7) status_hcr; pause ;;
            8) if installed && confirm "¿Reiniciar HCR ahora?"; then systemctl restart hcr-server.service && ok "Servicio reiniciado." || err "No se pudo reiniciar."; fi; pause ;;
            9) installed && service_toggle || err "HCR no está instalado."; pause ;;
            10) installed && uninstall_hcr || err "HCR no está instalado."; pause ;;
            11) more_options_menu ;;
            0) clear; continue ;;
            *) warn "Opción inválida."; sleep 1 ;;
        esac
    done
}

root_check
for cmd in curl systemctl ss awk sed; do
    command -v "$cmd" >/dev/null 2>&1 || { err "Falta el comando requerido: $cmd"; exit 1; }
done
main_menu